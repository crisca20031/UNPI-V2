# ============================================================================
# Copia este archivo como ".env.local" y llena cada valor.
#   (en tu computador)  cp .env.local.example .env.local
#   (en Vercel u otro hosting) pega estas mismas variables en su panel.
# NUNCA subas el archivo ".env.local" a GitHub: contiene secretos.
# ============================================================================

# Token permanente de la API (Usuario del sistema en Meta Business Manager).
WHATSAPP_CLOUD_API_TOKEN=

# ID del número del bot (321 352 4712). Está en: developers.facebook.com →
# tu app → WhatsApp → Configuración de la API → "Identificador de número de teléfono".
WHATSAPP_PHONE_NUMBER_ID=

# Una contraseña que TÚ inventas (ej. "unpi-verificacion-2026"). Debe ser igual a
# la que escribas en Meta al configurar el webhook.
WHATSAPP_VERIFY_TOKEN=

# Llave PRIVADA del Flow, en UNA sola línea, con los saltos de línea escritos como \n
# Ejemplo:  -----BEGIN ENCRYPTED PRIVATE KEY-----\nMIIFH...\n-----END ENCRYPTED PRIVATE KEY-----\n
# (El script "npm run generar-llaves" la deja lista para pegar aquí.)
WHATSAPP_FLOW_PRIVATE_KEY=

# Frase secreta con la que se protegió la llave privada.
WHATSAPP_FLOW_PRIVATE_KEY_PASSPHRASE=

# ----------------------------------------------------------------------------
# Adicionales (necesarios para que el Flow funcione y para mayor seguridad)
# ----------------------------------------------------------------------------

# ID del Flow (número largo que aparece en WhatsApp Manager → Flows, al crearlo).
WHATSAPP_FLOW_ID=

# "Clave secreta de la app" (App Secret): developers.facebook.com → tu app →
# Configuración → Básica. Sirve para comprobar que las peticiones vienen de Meta.
WHATSAPP_APP_SECRET=

# Opcional: escribe "draft" para probar el Flow ANTES de publicarlo. Bórralo al publicar.
WHATSAPP_FLOW_MODE=
